      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录"
          }
        }
      }
    },
    "Sign out of IronSage?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要退出 IronSage 吗？"
          }
        }
      }
    },
    "Support": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客服支持"
          }
        }
      }
