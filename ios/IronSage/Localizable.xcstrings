        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你昨晚睡得少，今天不加重量。"
          }
        }
      }
    },
    "You'll stop getting suggestions, and IronSage stops sending data to Anthropic. Past suggestions stay in your history." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
