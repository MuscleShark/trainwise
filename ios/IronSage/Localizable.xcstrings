        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        }
      }
    },
    "Workout logging arrives in the next update.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下个版本就能记录训练。"
          }
        }
      }
    }
