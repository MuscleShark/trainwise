{
  "sourceLanguage": "en",
  "strings": {
    "Account": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号"
          }
        }
      }
    },
    "App": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "Built-in programs and your own templates will be listed here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置训练计划和你自己的模板会列在这里。"
          }
        }
      }
    },
    "Couldn't load your account. Check your connection, then pull down to try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载账号信息。请检查网络，然后下拉重试。"
          }
        }
      }
    },
    "Email": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮箱"
          }
        }
      }
    },
    "Finished workouts will be listed here by week.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成的训练会按周列在这里。"
          }
        }
      }
    },
    "History": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史"
          }
        }
      }
    },
    "IronSage isn't set up": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "IronSage 尚未配置"
          }
        }
      }
    },
    "Know what to lift next.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一次练多重，心里有数。"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言"
          }
        }
      }
    },
    "Log every set, even without signal. Your training syncs to your account.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一组都能记下来，没有信号也可以。训练记录会同步到你的账号。"
          }
        }
      }
    },
    "No templates yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有模板"
          }
        }
      }
    },
    "No workout in progress": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有进行中的训练"
          }
        }
      }
    },
    "No workouts yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有训练记录"
          }
        }
      }
    },
    "Privacy policy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私政策"
          }
        }
      }
    },
